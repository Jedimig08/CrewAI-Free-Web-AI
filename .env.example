# ============================================================
# free-web-ai gateway + browser
# ============================================================
# Bearer token clients use to call the gateway. ./setup.sh generates one.
# Leave empty only if the gateway is not reachable outside the Docker
# network; empty disables gateway auth.
TFG_API_KEY=

# Browser desktop login (https://localhost:6081). ./setup.sh generates one.
# This is only the web-desktop password; it is not used by the gateway.
BROWSER_USER=admin
BROWSER_PASSWORD=

# Host ports.
BROWSER_GUI_HOST_PORT=6081
GATEWAY_HOST_PORT=3457

# Container user mapping (use `id -u` / `id -g` on the host).
PUID=1000
PGID=1000
TZ=Europe/Lisbon

# Prompt trimming and gateway request timeout.
TFG_CHUNK_CHARS=24000
TFG_REQUEST_TIMEOUT_SEC=300

# ============================================================
# CrewAI API
# ============================================================
# Bearer token clients use to call the CrewAI API. ./setup.sh generates one.
# Different from TFG_API_KEY.
CREWAI_API_KEY=

# Model exposed by the gateway.
CREWAI_MODEL=chatgpt-auto

# CrewAI API bind address/port. Keep 127.0.0.1 unless you put it behind a proxy.
CREWAI_HOST_BIND=127.0.0.1
CREWAI_HOST_PORT=8000

# Per-agent execution limit in seconds.
CREWAI_MAX_EXECUTION_SEC=300

# ============================================================
# Web UI
# ============================================================
# Bind to localhost by default: anyone who can reach the UI can run crews.
WEB_HOST_BIND=127.0.0.1
WEB_HOST_PORT=3000
